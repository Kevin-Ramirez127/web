---
import { buildSeoPayload, validatePayload } from '@easeo/core';
import { site } from '../lib/site';
import { seoConfig } from '../lib/seo-config.mjs';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title = site.title,
  description = site.description,
  path = '/',
  image = '/og-cover.png',
  noindex = false,
} = Astro.props;

const imageAlt = `${site.name} — Full-stack developer, automation & developer tools`;

const payload = buildSeoPayload(
  {
    entityType: path === '/' ? 'home' : 'page',
    title,
    description,
    image: new URL(image, site.url).toString(),
    imageAlt,
    authorName: site.author,
  },
  path,
  seoConfig,
  noindex
    ? { robotsIndex: false, robotsFollow: false }
    : { robotsIndex: true, robotsFollow: true, robotsMaxImagePreview: 'large' },
);

// Fail the build on real SEO regressions; warnings stay non-blocking.
const seoErrors = validatePayload(payload).filter((issue) => issue.severity === 'error');
if (seoErrors.length > 0) {
  throw new Error(`SEO validation failed: ${seoErrors.map((issue) => issue.ruleId).join(', ')}`);
}

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${site.url}/#person`,
  name: site.name,
  url: site.url,
  description: site.description,
  jobTitle: 'Full-Stack Developer (Web, Automation & Developer Tooling)',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Montevideo',
    addressCountry: 'UY',
  },
  sameAs: [site.social.github, site.social.linkedin],
  knowsAbout: ['React', 'Astro', 'TypeScript', 'Node.js', 'Go', 'Rust', 'Automation', 'Developer Tooling', 'REST APIs', 'PostgreSQL', 'MongoDB', 'AWS', 'Open Source'],
};
---

{/* Title, description, canonical, robots, Open Graph, Twitter Cards and JSON-LD. */}
<Fragment set:html={payload.renderHtml()} />
<meta name="keywords" content={site.keywords.join(', ')} />
<meta name="author" content={site.author} />
<meta name="theme-color" content="#222222" />
<meta name="color-scheme" content="light dark" />
<meta name="generator" content={Astro.generator} />

{/* Icons (no web manifest: keeps browsers from offering an app install) */}
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/favicon.svg" />

{/* Self-hosted fonts: preload the two LCP-critical faces. */}
<link rel="preload" href="/fonts/raleway-latin.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />

{/* Person entity, linked to the WebSite schema generated by easeo. */}
<script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
