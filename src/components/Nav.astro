---
import ThemeToggle from './ThemeToggle.astro';
---
<header class="fixed top-0 inset-x-0 z-40">
  <div class="mx-auto max-w-6xl px-6 md:px-10 flex items-center justify-between pt-6">
    <ThemeToggle />
    <button id="menu-btn" aria-expanded="false" class="bracket-link text-xl md:text-2xl font-light cursor-pointer">
      <span class="br">[</span><span>menu</span><span class="br">]</span><span class="fill-wipe" aria-hidden="true"><span class="br">[</span><span>menu</span><span class="br">]</span></span>
    </button>
  </div>
</header>

<div id="menu-overlay" class="fixed inset-0 z-50 bg-ink/95 backdrop-blur-md opacity-0 pointer-events-none">
  <div class="relative h-full mx-auto max-w-6xl px-6 md:px-10 flex flex-col">
    <div class="flex items-center justify-between pt-6">
      <ThemeToggle />
      <button id="menu-close" class="bracket-link text-xl md:text-2xl cursor-pointer">
        <span class="br">[</span><span>close</span><span class="br">]</span><span class="fill-wipe" aria-hidden="true"><span class="br">[</span><span>close</span><span class="br">]</span></span>
      </button>
    </div>
    <nav class="flex-1 flex flex-col justify-center gap-2 md:gap-3">
      <a data-menu-link href="#top" class="group flex items-baseline gap-4 py-2 border-b hairline border-transparent hover:border-line transition-colors">
        <span class="text-4xl md:text-6xl font-extralight text-bone group-hover:text-accent transition">Home</span>
      </a>
      <a data-menu-link href="#about" class="group flex items-baseline gap-4 py-2 border-b hairline border-transparent hover:border-line transition-colors">
        <span class="text-4xl md:text-6xl font-extralight text-bone group-hover:text-accent transition">About me</span>
      </a>
      <a data-menu-link href="#experience" class="group flex items-baseline gap-4 py-2 border-b hairline border-transparent hover:border-line transition-colors">
        <span class="text-4xl md:text-6xl font-extralight text-bone group-hover:text-accent transition">Experience</span>
      </a>
      <a data-menu-link href="#projects" class="group flex items-baseline gap-4 py-2 border-b hairline border-transparent hover:border-line transition-colors">
        <span class="text-4xl md:text-6xl font-extralight text-bone group-hover:text-accent transition">Projects</span>
      </a>
      <a data-menu-link href="#skills" class="group flex items-baseline gap-4 py-2 border-b hairline border-transparent hover:border-line transition-colors">
        <span class="text-4xl md:text-6xl font-extralight text-bone group-hover:text-accent transition">Skills</span>
      </a>
      <a data-menu-link href="#contact" class="group flex items-baseline gap-4 py-2">
        <span class="text-4xl md:text-6xl font-extralight text-bone group-hover:text-accent transition">Contact</span>
      </a>
    </nav>
    <div class="pb-10 flex flex-wrap gap-6 font-matrix text-sm text-bone-faint">
      <span>Montevideo, Uruguay</span>
      <a class="text-accent hover:text-bone transition" href="https://github.com/Kevin-Ramirez127" target="_blank" rel="noreferrer">[ GitHub ]</a>
      <a class="text-accent hover:text-bone transition" href="https://www.linkedin.com/in/kevin-ramirez-silva/" target="_blank" rel="noreferrer">[ LinkedIn ]</a>
    </div>
  </div>
</div>
