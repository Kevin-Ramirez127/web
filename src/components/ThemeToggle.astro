---
// Theme toggle. Server-renders the dark-mode action ("light"); the client
// script in BaseLayout syncs all instances to the stored theme on load.
---
<button type="button" data-theme-toggle aria-label="Switch to light theme" class="bracket-link text-xl md:text-2xl font-light cursor-pointer"><span class="br">[</span><span data-theme-label>light</span><span class="br">]</span><span class="fill-wipe" aria-hidden="true"><span class="br">[</span><span data-theme-label>light</span><span class="br">]</span></span></button>
