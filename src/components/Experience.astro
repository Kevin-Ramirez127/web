---
const jobs = [
  {
    type: 'Full-Time · Hybrid',
    role: 'Full Stack Developer (Automation & Process Optimization)',
    company: 'Arbusta',
    place: 'Montevideo, Uruguay',
    period: 'Oct 2023 — May 2025',
    team: '6 people',
    summary: 'Built integrated solutions combining browser extensions, microservices and real-time data analysis to increase operational efficiency, reduce manual errors and inform decisions with strategic data.',
    achievements: [
      'Measured SLA in real time across 10+ simultaneous projects, cutting manual time and improving visibility.',
      'Automated critical processes, reducing manual errors and increasing efficiency during internal and external audits.',
      'Built custom quality-monitoring and process-control tools that impacted external audits with outstanding results. Designed bots and extensions capturing DOM interactions streamed via microservices for ML analysis.',
    ],
    stack: ['Chrome extensions','TypeScript','JavaScript','Google Apps Script','Node.js','Docker','AWS','GitHub'],
  },
  {
    type: 'Part-time · Hybrid',
    role: 'META CAPI Developer',
    company: 'Arbusta — Meta',
    place: 'Montevideo, Uruguay',
    period: 'Jul 2022 — Sep 2023',
    team: '3 people',
    summary: 'Led Meta Conversions API Gateway implementation on AWS, letting clients optimize conversion tracking and campaign effectiveness with reliable data quality and tailored support.',
    achievements: [
      'Configured and deployed Meta CAPI Gateway on AWS — robust and scalable integration.',
      'Advised clients and stakeholders on API usage, improving digital campaign results.',
      'Detected and fixed data-collection inconsistencies; documented and standardized processes for future maintenance.',
    ],
    stack: ['CAPI','TypeScript','JavaScript','Facebook API','GitHub'],
  },
  {
    type: 'Part-time · Remote',
    role: 'Frontend Developer',
    company: 'Bridge for Billions',
    place: 'Montevideo, Uruguay',
    period: 'Jun 2022 — Sep 2023',
    team: '+10 people',
    summary: 'Optimized and continuously developed the entrepreneurship platform — custom components to spec, critical usability fixes, and leaner backend communication with multidisciplinary teams.',
    achievements: [
      'Developed and optimized React.js components with Redux-Saga and Ant Design for visual and functional consistency.',
      'Sharply reduced backend requests in key modules — faster performance, lower infra cost.',
      'Fixed user-panel bugs that caused wrong perceptions, increasing trust and satisfaction.',
    ],
    stack: ['Redux.js','React','CSS','Ant Design','GitHub'],
  },
];
---
<section id="experience" class="relative">
  <div class="mx-auto max-w-6xl px-6 md:px-10 py-20 md:py-28">
    <p class="reveal font-matrix text-xs tracking-[0.25em] text-bone-faint">...CAREER...</p>
    <h2 class="reveal mt-3 text-5xl md:text-6xl font-extralight tracking-tight">Experience</h2>
    <p class="reveal mt-4 max-w-xl text-bone-faint font-light">Developer passionate about building innovative solutions and automating processes.</p>

    <div class="mt-12 space-y-10">
      {jobs.map((j) => (
        <article class="reveal border hairline bg-ink-soft/40 p-6 md:p-9 hover:border-accent/40 transition-colors">
          <div class="flex flex-wrap items-center gap-3 font-matrix text-[11px] md:text-xs tracking-widest text-bone-faint">
            <span class="border hairline px-2 py-1 text-bone/80">{j.type}</span>
            <span>{j.period}</span>
            <span>·</span>
            <span>{j.team}</span>
          </div>
          <h3 class="mt-4 text-2xl md:text-3xl font-light text-bone">{j.role}</h3>
          <p class="mt-1 text-accent font-light text-lg">{j.company} <span class="text-bone-faint text-base">— {j.place}</span></p>
          <p class="mt-4 text-bone/85 font-light leading-relaxed max-w-3xl">{j.summary}</p>
          <h4 class="mt-6 font-matrix text-xs tracking-[0.2em] text-bone-faint">HIGHLIGHTS</h4>
          <ul class="mt-3 space-y-2 max-w-3xl font-light text-bone/85">
            {j.achievements.map(a => (
              <li class="flex gap-3"><span class="text-accent">·</span><span>{a}</span></li>
            ))}
          </ul>
          <div class="mt-6 flex flex-wrap gap-2">
            {j.stack.map(s => (
              <span class="font-matrix text-xs border hairline px-2.5 py-1 text-bone-dim">{s}</span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
