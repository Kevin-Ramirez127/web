---
const groups = [
  { title: 'Frontend Engineering', tags: ['React.js', 'Astro', 'TypeScript', 'Tailwind CSS', 'JavaScript', 'Redux', 'Zustand', 'Ant Design', 'Accessibility'] },
  { title: 'Backend & APIs', tags: ['Node.js', 'Express.js', 'Go', 'REST APIs', 'SSE', 'PostgreSQL', 'MongoDB'] },
  { title: 'Automation & Integrations', tags: ['Chrome extensions', 'Google Apps Script', 'GitHub Actions', 'CI/CD', 'Webhooks', 'Meta CAPI'] },
  { title: 'Systems & Developer Tooling', tags: ['Rust', 'Go', 'Bash', 'Linux', 'eframe / egui', 'systemd'] },
  { title: 'AI & Tooling', tags: ['OpenAI API', 'OpenCode plugins', 'AI agent workflows', 'Prompt design'] },
  { title: 'Delivery & Quality', tags: ['Docker', 'AWS', 'Vercel', 'Jest', 'Cypress', 'Web Vitals', 'Git & GitHub'] },
];
const extra = ['Python', 'Hugo', 'Vite / Webpack', 'NPM / Yarn / Pnpm', 'Figma', 'Jira', 'Notion', 'Slack', 'Trello'];
---
<section id="skills" class="relative overflow-hidden">
  <div class="relative mx-auto max-w-6xl px-6 md:px-10 py-20 md:py-28">
    <p class="reveal font-matrix text-xs tracking-[0.25em] text-bone-faint">...STACK...</p>
    <h2 class="reveal mt-3 text-5xl md:text-6xl font-extralight tracking-tight">Skills</h2>
    <p class="reveal mt-4 max-w-xl text-bone-faint font-light">The stack I reach for, from the interface down to the daemon.</p>

    <div class="mt-12 grid md:grid-cols-2 lg:grid-cols-3 gap-px bg-line/40 border hairline">
      {groups.map(g => (
        <div class="reveal bg-ink-soft/95 p-6 md:p-7">
          <h3 class="text-xl font-light text-bone">{g.title}</h3>
          <div class="mt-4 flex flex-wrap gap-2">
            {g.tags.map(t => (
              <span class="font-matrix text-xs border hairline px-2.5 py-1 text-bone-dim hover:text-accent hover:border-accent/50 transition">{t}</span>
            ))}
          </div>
        </div>
      ))}
    </div>

    <h3 class="reveal mt-10 font-matrix text-xs tracking-[0.2em] text-bone-faint">ALSO IN THE TOOLBOX</h3>
    <p class="reveal mt-4 font-light text-bone/80 leading-loose">{extra.join(' · ')}</p>
  </div>
</section>
