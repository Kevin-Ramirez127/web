---
// Right-side vertical dot-matrix rails, like the reference Hero/About screenshots.
interface Props {
  items?: string[];
}
const { items = ['Golang', 'TypeScript', 'Linux Arch'] } = Astro.props;
---
<div aria-hidden="true" class="pointer-events-none absolute inset-y-0 right-0 w-[38%] hidden md:block overflow-hidden">
  <div class="absolute inset-0 plus-grid opacity-70"></div>
  <div class="absolute inset-y-0 right-6 lg:right-14 flex justify-end gap-10 lg:gap-16 py-10">
    {items.map((t) => (
      <div class="vertical-rl rotate-180 dot-matrix text-[26px] leading-[1.1] whitespace-nowrap select-none">
        {t}
      </div>
    ))}
  </div>
  <!-- faint horizontal dotted separators -->
  <div class="absolute inset-0 opacity-60" style="background-image: radial-gradient(circle, #2e2d2b 1px, transparent 1.3px); background-size: 100% 120px;"></div>
</div>
<div aria-hidden="true" class="pointer-events-none absolute inset-0 md:hidden overflow-hidden opacity-60">
  <div class="absolute inset-0 plus-grid"></div>
</div>
