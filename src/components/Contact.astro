---
---
<section id="contact" class="relative overflow-hidden">
  <div class="relative mx-auto max-w-6xl px-6 md:px-10 py-20 md:py-28 grid lg:grid-cols-2 gap-12">
    <div>
      <p class="reveal font-matrix text-xs tracking-[0.25em] text-bone-faint">...CONTACT...</p>
      <h2 class="reveal mt-3 text-5xl md:text-6xl font-extralight tracking-tight leading-[1.05]">Let's work<br/>together</h2>
      <p class="reveal mt-5 max-w-md text-bone/85 font-light text-lg">Have an amazing idea? I'd love to hear it and help you make it a reality.</p>

      <div class="reveal mt-8 space-y-3 text-xl font-light">
        <a class="bracket-link" href="https://github.com/Kevin-Ramirez127" target="_blank" rel="noreferrer"><span class="br">[</span><span>GitHub</span><span class="br">]</span><span class="fill-wipe" aria-hidden="true"><span class="br">[</span><span>GitHub</span><span class="br">]</span></span></a><br/>
        <a class="bracket-link" href="https://www.linkedin.com/in/kevin-ramirez-silva/" target="_blank" rel="noreferrer"><span class="br">[</span><span>LinkedIn</span><span class="br">]</span><span class="fill-wipe" aria-hidden="true"><span class="br">[</span><span>LinkedIn</span><span class="br">]</span></span></a>
      </div>

      <div class="reveal mt-8 border-l border-bone/50 pl-5 text-bone-faint font-light">
        <p class="font-matrix text-xs tracking-[0.2em] mb-1">RESPONSE TIME</p>
        <p>I reply within the first 24 hours.</p>
        <p class="mt-2">Montevideo, Uruguay</p>
      </div>
    </div>

    <form id="contact-form" class="reveal border hairline bg-ink-soft/40 p-6 md:p-8 space-y-5" novalidate>
      <h3 class="text-2xl font-light">Send me a message</h3>
      <div class="grid sm:grid-cols-2 gap-5">
        <label class="block">
          <span class="font-matrix text-xs tracking-widest text-bone-faint">NAME</span>
          <input required type="text" name="name" placeholder="Your name" maxlength="100" autocomplete="name" class="mt-2 w-full bg-transparent border hairline px-3 py-2.5 font-light text-bone placeholder:text-bone-faint/70 focus:outline-none focus:border-accent transition" />
        </label>
        <label class="block">
          <span class="font-matrix text-xs tracking-widest text-bone-faint">EMAIL</span>
          <input required type="email" name="email" placeholder="you@email.com" autocomplete="email" class="mt-2 w-full bg-transparent border hairline px-3 py-2.5 font-light text-bone placeholder:text-bone-faint/70 focus:outline-none focus:border-accent transition" />
        </label>
      </div>
      <div class="grid sm:grid-cols-2 gap-5">
        <label class="block">
          <span class="font-matrix text-xs tracking-widest text-bone-faint">SUBJECT</span>
          <input required type="text" name="subject" placeholder="Project inquiry" class="mt-2 w-full bg-transparent border hairline px-3 py-2.5 font-light text-bone placeholder:text-bone-faint/70 focus:outline-none focus:border-accent transition" />
        </label>
      </div>
      {/* Honeypot: humans never see/fill this — bots do. */}
      <div class="honeypot" aria-hidden="true">
        <label>Website
          <input type="text" name="website" placeholder="Website" tabindex="-1" autocomplete="off" />
        </label>
      </div>
      <label class="block">
        <span class="font-matrix text-xs tracking-widest text-bone-faint">MESSAGE</span>
        <textarea required name="message" rows="5" placeholder="Tell me about your idea..." maxlength="2000" minlength="10" class="mt-2 w-full bg-transparent border hairline px-3 py-2.5 font-light text-bone placeholder:text-bone-faint/70 focus:outline-none focus:border-accent transition resize-y"></textarea>
      </label>
      <button type="submit" class="bracket-link text-2xl cursor-pointer">
        <span class="br">[</span><span>Send Message</span><span class="br">]</span><span class="fill-wipe" aria-hidden="true"><span class="br">[</span><span>Send Message</span><span class="br">]</span></span>
      </button>
    </form>

    <script>
      // Mirrors dev_portfolio Contact.tsx behavior: honeypot -> validate ->
      // POST /api/contact JSON -> reset + toast (LinkedIn fallback on error).
      const form = document.getElementById('contact-form') as HTMLFormElement | null;
      const toasts = document.getElementById('contact-toasts');

      function pushToast(kind: 'ok' | 'err') {
        if (!toasts) return;
        const el = document.createElement('div');
        el.className = 'border hairline bg-ink-soft px-4 py-3 space-y-2';
        el.innerHTML = kind === 'ok'
          ? '<p class="font-light text-bone"><span class="text-accent font-matrix">[ ✓ ]</span> Email received</p>'
          : '<p class="font-light text-bone"><span class="text-accent font-matrix">[ ! ]</span> Error sending message. Please try contact to me via LinkedIn.</p>' +
            '<p><a class="bracket-link" target="_blank" rel="noreferrer" href="https://www.linkedin.com/in/kevin-ramirez-silva/?locale=en_US"><span class="br">[</span><span>LinkedIn</span><span class="br">]</span></a></p>';
        const dismiss = document.createElement('button');
        dismiss.type = 'button';
        dismiss.className = 'bracket-link text-sm cursor-pointer';
        dismiss.innerHTML = '<span class="br">[</span><span>dismiss</span><span class="br">]</span>';
        dismiss.addEventListener('click', () => el.remove());
        el.appendChild(dismiss);
        toasts.appendChild(el);
      }

      function resetForm() {
        form?.reset();
      }

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!form) return;
        const data = new FormData(form);
        const name = String(data.get('name') ?? '');
        const email = String(data.get('email') ?? '');
        const subject = String(data.get('subject') ?? '');
        const message = String(data.get('message') ?? '');
        const website = String(data.get('website') ?? '');

        // Honeypot: silently drop bots.
        if (website) return;

        if (![name, email, subject, message].every((f) => f.trim() !== '')) {
          alert('Please fill in all required fields.');
          return;
        }

        try {
          const response = await fetch('/api/contact', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name, email, subject, message, website }),
          });
          if (!response.ok) throw new Error('Something went wrong');
          pushToast('ok');
        } catch {
          pushToast('err');
        }
        resetForm();
      });
    </script>
  </div>
</section>

<footer>
  <div class="mx-auto max-w-6xl px-6 md:px-10 py-10 flex flex-col md:flex-row gap-6 md:items-center justify-between">
    <div>
      <p class="text-xl font-light">Kevin Ramirez</p>
      <p class="mt-1 text-sm text-bone-faint font-light max-w-sm">Frontend developer specialized in automation, creating exceptional web experiences with modern tech.</p>
    </div>
    <nav class="flex flex-wrap gap-5 font-light text-bone-dim">
      <a href="#about" class="hover:text-accent transition">About</a>
      <a href="#experience" class="hover:text-accent transition">Experience</a>
      <a href="#projects" class="hover:text-accent transition">Projects</a>
      <a href="#skills" class="hover:text-accent transition">Skills</a>
      <a href="#contact" class="hover:text-accent transition">Contact</a>
    </nav>
  </div>
  <div>
    <div class="mx-auto max-w-6xl px-6 md:px-10 py-5 flex flex-col sm:flex-row gap-2 justify-between font-matrix text-xs text-bone-faint">
      <span>© 2026 Kevin Ramirez. Made with tea.</span>
      <span>Built with Astro, TypeScript & Tailwind CSS</span>
    </div>
  </div>
</footer>
