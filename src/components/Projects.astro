---
const projects = [
  {
    name: 'opencode-telegram',
    url: 'https://github.com/Kevin-Ramirez127/opencode-telegram',
    meta: 'Go · GPL-3.0 · ★ 4',
    description: 'A Go daemon that watches every OpenCode session and sends finished runs, questions and permission requests to allowlisted Telegram chats. Answer from your phone instead of babysitting a terminal.',
    stack: ['Go', 'SSE', 'REST', 'Telegram Bot API', 'systemd'],
  },
  {
    name: 'gitsion',
    url: 'https://github.com/Kevin-Ramirez127/gitsion',
    meta: 'Go · Astro · MongoDB',
    description: 'A self-hosted feed for the GitHub repositories you care about: pushes, pull requests and issues in one newest-first stream. Go standard-library backend, MongoDB snapshots and an Astro SSR dashboard.',
    stack: ['Go', 'Astro', 'MongoDB', 'SSR', 'GitHub API'],
  },
  {
    name: 'r-modals',
    url: 'https://github.com/Kevin-Ramirez127/r-modals',
    meta: 'Rust · GPL-3.0 · ★ 2',
    description: 'Instant, borderless modals for Rust on X11 and Wayland. One call opens a searchable picker with submenus, shortcuts, prefixes, themes and multi-select - and it is the picker behind quick-bitwarden.',
    stack: ['Rust', 'eframe', 'egui', 'X11', 'Wayland'],
  },
  {
    name: 'quick-bitwarden',
    url: 'https://github.com/Kevin-Ramirez127/quick-bitwarden',
    meta: 'Rust · GPL-3.0 · ★ 3',
    description: 'A background daemon and native picker for the Bitwarden CLI. Caches the vault in memory, copies a password in one keystroke and scrubs it from clipboard history on the way out.',
    stack: ['Rust', 'Bitwarden CLI', 'r-modals', 'cliphist'],
  },
  {
    name: 'rempkg',
    url: 'https://github.com/Kevin-Ramirez127/rempkg',
    meta: 'Go · GPL-3.0 · ★ 2',
    description: 'One wrapper for pacman, yay, paru, apt and dnf that records exactly what you installed - with tags - in a JSONC file, so dependencies never pollute your list.',
    stack: ['Go', 'CLI', 'JSONC'],
  },
  {
    name: 'opencode-tools',
    url: 'https://github.com/Kevin-Ramirez127/opencode-tools',
    meta: 'TypeScript · MIT',
    description: 'Plugins that make OpenCode fit the way I work: control the Telegram daemon from the TUI and jump between user messages in long sessions.',
    stack: ['TypeScript', 'OpenCode plugins'],
  },
];

const contributions = [
  {
    name: 'Postal',
    url: 'https://github.com/emiliano-go/postal',
    meta: 'Rust · ★ 16',
    description: 'Native WhatsApp client speaking the multi-device protocol. Contributed UI, accessibility and chat-sidebar fixes.',
  },
  {
    name: 'Corcho',
    url: 'https://github.com/emiliano-go/corcho',
    meta: 'Rust · Qt6',
    description: 'Native canvas for personal development. Worked on website behavior, resize handling, checklists and picture-in-picture windows.',
  },
  {
    name: 'LibreCourseUY / libreblog',
    url: 'https://github.com/LibreCourseUY/libreblog',
    meta: 'Hugo · GitHub Actions',
    description: 'Community blog auto-deployed with Actions. Contributed documentation for the React components course.',
  },
];
---
<section id="projects" class="relative overflow-hidden">
  <div class="relative mx-auto max-w-6xl px-6 md:px-10 py-20 md:py-28">
    <p class="reveal font-matrix text-xs tracking-[0.25em] text-bone-faint">...WORK...</p>
    <h2 class="reveal mt-3 text-5xl md:text-6xl font-extralight tracking-tight">Projects</h2>
    <p class="reveal mt-4 max-w-xl text-bone-faint font-light">Open-source tools I built to remove a manual step - and use myself.</p>

    <div class="reveal mt-7 flex flex-wrap items-center gap-x-6 gap-y-3">
      <a href="https://www.projects.ramirezkevin.dev/" class="bracket-link text-xl">
        <span class="br">[</span><span>All projects</span><span class="br">]</span><span class="fill-wipe" aria-hidden="true"><span class="br">[</span><span>All projects</span><span class="br">]</span></span>
      </a>
      <p class="max-w-xl text-sm md:text-base text-bone-faint font-light">
        The complete collection lives on the dedicated projects site at
        <a href="https://www.projects.ramirezkevin.dev/" class="text-accent hover:text-bone transition-colors">projects.ramirezkevin.dev</a>
        &mdash; full case studies, source links and the open-source projects I contribute to.
      </p>
    </div>

    <div class="mt-12 space-y-6">
      {projects.map((p) => (
        <article class="reveal border hairline bg-ink-soft/95 p-6 md:p-8 hover:border-accent/40 transition-colors">
          <div class="flex flex-wrap items-baseline justify-between gap-3">
            <h3 class="text-2xl md:text-3xl font-light text-bone">
              <a href={p.url} target="_blank" rel="noreferrer" class="hover:text-accent transition-colors">{p.name}</a>
            </h3>
            <p class="font-matrix text-[11px] tracking-widest text-bone-faint font-bold">{p.meta}</p>
          </div>
          <p class="mt-3 max-w-3xl text-bone/85 font-light leading-relaxed">{p.description}</p>
          <div class="mt-5 flex flex-wrap items-center justify-between gap-4">
            <div class="flex flex-wrap gap-2">
              {p.stack.map((s) => (
                <span class="font-matrix text-xs border hairline px-2.5 py-1 text-bone-dim">{s}</span>
              ))}
            </div>
            <a href={p.url} target="_blank" rel="noreferrer" class="bracket-link text-xl">
              <span class="br">[</span><span>Code</span><span class="br">]</span><span class="fill-wipe" aria-hidden="true"><span class="br">[</span><span>Code</span><span class="br">]</span></span>
            </a>
          </div>
        </article>
      ))}
    </div>

    <h3 class="reveal mt-14 font-matrix text-xs tracking-[0.2em] text-bone-faint">SELECTED OPEN-SOURCE CONTRIBUTIONS</h3>
    <div class="mt-5 space-y-4">
      {contributions.map((c) => (
        <a href={c.url} target="_blank" rel="noreferrer" class="reveal group flex flex-col gap-2 border hairline bg-ink-soft/95 p-5 md:flex-row md:items-baseline md:justify-between md:gap-8 md:p-6 hover:border-accent/40 transition-colors">
          <div>
            <h4 class="text-xl font-light text-bone group-hover:text-accent transition-colors">{c.name}</h4>
            <p class="mt-1 max-w-2xl text-bone/80 font-light leading-relaxed">{c.description}</p>
          </div>
          <p class="shrink-0 font-matrix text-[11px] tracking-widest text-bone-faint font-bold">{c.meta}</p>
        </a>
      ))}
    </div>
  </div>
</section>
