---
const projects = [
  {
    name: 'rempkg',
    url: 'https://github.com/Kevin-Ramirez127/rempkg',
    description: 'One wrapper for many package managers to remember and tag what you install.',
    meta: 'Go · ★ 2',
    stack: ['Go', 'CLI'],
  },
  {
    name: 'quick-bitwarden',
    url: 'https://github.com/Kevin-Ramirez127/quick-bitwarden',
    description: 'A quick way to copy your Bitwarden passwords that works on rofi/wofi window.',
    meta: 'Shell · ★ 3',
    stack: ['Shell', 'Rofi', 'Wofi'],
  },
  {
    name: 'r-modals',
    url: 'https://github.com/Kevin-Ramirez127/r-modals',
    description: 'Simple and fast modals made with Rust.',
    meta: 'Rust',
    stack: ['Rust'],
  },
];
---
<section id="projects" class="relative overflow-hidden">
  <div class="relative mx-auto max-w-6xl px-6 md:px-10 py-20 md:py-28">
    <p class="reveal font-matrix text-xs tracking-[0.25em] text-bone-faint">...WORK...</p>
    <h2 class="reveal mt-3 text-5xl md:text-6xl font-extralight tracking-tight">Projects</h2>
    <p class="reveal mt-4 max-w-xl text-bone-faint font-light">Open source — built, used, and maintained by me.</p>

    <div class="mt-12 space-y-6">
      {projects.map((p) => (
        <article class="reveal border hairline bg-ink-soft/40 p-6 md:p-8 hover:border-accent/40 transition-colors">
          <div class="flex flex-wrap items-baseline justify-between gap-3">
            <h3 class="text-2xl md:text-3xl font-light text-bone">
              <a href={p.url} target="_blank" rel="noreferrer" class="hover:text-accent transition-colors">{p.name}</a>
            </h3>
            <p class="font-matrix text-[11px] tracking-widest text-bone-faint font-bold">{p.meta}</p>
          </div>
          <p class="mt-3 max-w-3xl text-bone/85 font-light leading-relaxed">{p.description}</p>
          <div class="mt-5 flex flex-wrap items-center justify-between gap-4">
            <div class="flex flex-wrap gap-2">
              {p.stack.map((s) => (
                <span class="font-matrix text-xs border hairline px-2.5 py-1 text-bone-dim">{s}</span>
              ))}
            </div>
            <a href={p.url} target="_blank" rel="noreferrer" class="bracket-link text-xl">
              <span class="br">[</span><span>Code</span><span class="br">]</span><span class="fill-wipe" aria-hidden="true"><span class="br">[</span><span>Code</span><span class="br">]</span></span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
